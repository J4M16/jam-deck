{
  "name": "jam-deck",
  "version": "0.16.0",
  "private": true,
  "description": "Jam 的 Obsidian 副屏工作台插件（GameDeck 分支含实验性 3D 世界）",
  "scripts": {
    "build:world": "node scripts/build-world.mjs",
    "check": "node --check main.js && node --check game-deck-world.js",
    "test": "node tests/jam-deck-test.js",
    "verify": "npm run build:world && npm run check && npm test",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
